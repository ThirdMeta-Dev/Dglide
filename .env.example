# Copy to .env.local and fill in. Never commit real values.

# --- Required: the site returns 500 on every page without these ---
# Supabase project (DGlide uses project ref yytdzxrryboagezbjiqa)
NEXT_PUBLIC_SUPABASE_URL=https://yytdzxrryboagezbjiqa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: blog/case-study data, admin APIs, media uploads
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin panel ---
# Comma-separated allowlist. If empty, ANY signed-in Supabase user gets admin access.
ADMIN_EMAILS=

# --- Optional ---
# Canonical URL for metadata, sitemap, robots (defaults to https://www.dglide.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AWS SES. Lead notifications are skipped if unset; case-study PDF emails fail.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=ap-south-1

# Google Apps Script webhooks that append form leads to Sheets
GOOGLE_SHEETS_WEBHOOK_URL=
FSM_INDIA_GOOGLE_SHEETS_WEBHOOK_URL=

# AI helpers in the blog admin (lib/gemini.ts calls Groq)
GROQ_API_KEY=
